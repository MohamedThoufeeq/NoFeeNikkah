{
  "name": "nofeenikkah-client",
  "private": true,
  "version": "1.0.0",
  "description": "Free, private Muslim matrimonial web client.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/src/server.js",
    "start": "node server/src/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src server --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "test": "node --test server/tests/*.test.js",
    "test:server": "node --test server/tests/*.test.js",
    "seed:demo": "node server/scripts/seed-demo.js",
    "check": "npm run lint && npm run test:server && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "compression": "^1.8.2",
