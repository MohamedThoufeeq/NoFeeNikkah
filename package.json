    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-phone-number-input": "^3.3.9",
    "react-router-dom": "^7.18.4",
    "react-select": "^5.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^8.44.0",
    "eslint-plugin-react": "^7.32.2",
